{
  "name": "redirect-lint",
  "version": "0.1.0",
  "description": "Redirect chain checker for _redirects, CSV and JSON rules: finds loops, chains and clashes, and flattens chains to one hop.",
  "keywords": [
    "redirect chain checker",
    "bulk redirect checker",
    "301 redirect checker",
    "netlify redirects",
    "_redirects",
    "cloudflare-pages",
    "wordpress-redirection",
    "redirect-loop",
    "seo",
    "lint",
    "csv",
    "410",
    "cli"
  ],
  "homepage": "https://oss.saimulislam.com/redirect-lint/",
  "bugs": {
    "url": "https://github.com/saimulft/redirect-lint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saimulft/redirect-lint.git"
  },
  "license": "MIT",
  "author": "Saimul Islam (https://github.com/saimulft)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "redirect-lint": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint . && npm run lint:names",
    "lint:names": "ls-lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ls-lint/ls-lint": "^2.3.2",
    "@types/node": "^20.19.43",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
